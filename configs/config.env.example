# MiniMax-M3.1-Flash TP4 on four DGX Sparks (GB10): site config for scripts/serve.sh.
# Copy to configs/config.env and edit. Rank 0 is the API head and must be first in NODES.

# ssh targets, rank 0 first (rank 0 also serves the OpenAI API)
NODES="user@spark-a user@spark-b user@spark-c user@spark-d"
# rank 0's address on the QSFP fabric (torch.distributed / NCCL rendezvous)
HEAD_IP=192.168.192.1
MASTER_PORT=29511
API_PORT=8003

# Weights: either the same local path on every node, or an NFS export that every node reads
# (docker mounts it itself through an NFS volume; nothing to mount on the hosts).
MODEL_DIR=/var/tmp/models/MiniMax-M3.1-Flash
MODEL_NFS=192.168.192.1:/var/tmp/models/MiniMax-M3.1-Flash   # leave empty if MODEL_DIR exists on every node
SERVED_NAME=minimax-m3.1-flash

IMAGE=vllm/vllm-openai:minimax-m31-flash-arm64-cu134
# Per-node mode, one word per node in NODES order: "image" runs IMAGE from the node's docker store.
# "overlay" is for a node without ~30 GB of disk for the image: it mounts the image's /usr/local from NFS
# (OVERLAY_NFS, made with scripts/export_runtime.sh) over the NGC PyTorch container already on the node.
MODES="image image image image"
OVERLAY_BASE=nvcr.io/nvidia/pytorch:26.07-py3
OVERLAY_NFS=192.168.192.1:/var/tmp/models/m31flash-rt/usr-local

# Fabric
NET_IF=enp1s0f0np0          # the QSFP netdev that carries HEAD_IP's subnet
HCA=rocep1s0f0              # RoCE device for NCCL (ibv_devices)
GID_INDEX=3                 # RoCE v2 GID index (show_gids)
IB_ADDR_RANGE=192.168.192.0/24

# Engine
GMU=0.80                    # gpu-memory-utilization: 0.80 = 1,415,656-token KV pool on our Sparks (README, memory section)
GUARD_MB=3072               # scripts/guard.sh kills m31-tp4 when MemAvailable drops under this (MB)
MAXLEN=300000               # max-model-len
MAXSEQS=8                   # max-num-seqs
MAXBATCH=8192               # max-num-batched-tokens (prefill chunk)
SPEC='{"method":"dspark","num_speculative_tokens":3,"attention_backend":"TRITON_ATTN","kv_cache_dtype":"fp8","draft_sample_method":"probabilistic","rejection_sample_method":"block"}'
# SPEC=off disables DSpark
